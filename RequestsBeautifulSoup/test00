import requests
from bs4 import BeautifulSoup
import time
import random
from typing import Optional, Dict, List, Set
import logging
import json
from datetime import datetime
import os
from urllib.parse import urljoin, urlparse
import hashlib

# 配置日志
logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
logger = logging.getLogger(__name__)

# ==================== 基础爬虫类 ====================
class MultiPageScraper:
    """多页面爬虫 - 基础类"""
    
    def __init__(self, base_url: str, output_dir: str = 'rag_data', max_pages: int = 100):
        self.base_url = base_url.rstrip('/')
        self.output_dir = output_dir
        self.max_pages = max_pages
        
        self.visited_urls: Set[str] = set()
        self.pending_urls: List[str] = [base_url]
        self.results: List[Dict] = []
        
        os.makedirs(output_dir, exist_ok=True)
        os.makedirs(os.path.join(output_dir, 'pages'), exist_ok=True)
        
        self.session = requests.Session()
        self.session.headers.update({
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36',
            'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8',
            'Accept-Language': 'zh-CN,zh;q=0.9,en;q=0.8',
        })
        self.timeout = 10
        
        # robots.txt规则
        self.disallow_paths = ['/special']
    
    def is_allowed(self, url: str) -> bool:
        """检查URL是否被robots.txt允许"""
        parsed = urlparse(url)
        path = parsed.path or '/'
        
        for disallow in self.disallow_paths:
            if path.startswith(disallow):
                logger.warning(f"⛔ robots.txt禁止: {url}")
                return False
        return True
    
    def normalize_url(self, url: str) -> str:
        """标准化URL"""
        absolute_url = urljoin(self.base_url, url)
        parsed = urlparse(absolute_url)
        clean_url = f"{parsed.scheme}://{parsed.netloc}{parsed.path}"
        if parsed.query:
            clean_url += f"?{parsed.query}"
        return clean_url
    
    def is_same_domain(self, url: str) -> bool:
        """检查是否同域名"""
        parsed_base = urlparse(self.base_url)
        parsed_url = urlparse(url)
        return parsed_base.netloc == parsed_url.netloc
    
    def fetch_page(self, url: str, retry: int = 3) -> Optional[requests.Response]:
        """获取页面"""
        for attempt in range(retry):
            try:
                logger.info(f"📥 获取页面: {url} (尝试 {attempt + 1}/{retry})")
                response = self.session.get(url, timeout=self.timeout)
                response.raise_for_status()
                
                content_type = response.headers.get('Content-Type', '')
                if 'text/html' not in content_type:
                    logger.warning(f"⚠️ 非HTML内容: {content_type}")
                    return None
                
                logger.info(f"✅ 成功获取: {url}")
                return response
                
            except requests.exceptions.RequestException as e:
                logger.error(f"❌ 请求失败: {e}")
                if attempt < retry - 1:
                    time.sleep(random.uniform(1, 3))
                else:
                    return None
        return None
    
    def extract_links(self, soup: BeautifulSoup, base_url: str) -> List[str]:
        """从页面提取所有链接"""
        links = []
        
        for a_tag in soup.find_all('a', href=True):
            href = a_tag.get('href')
            if not href or href.startswith('#') or href.startswith('javascript:'):
                continue
            
            absolute_url = self.normalize_url(href)
            
            if not self.is_same_domain(absolute_url):
                continue
            
            if not self.is_allowed(absolute_url):
                continue
            
            if absolute_url not in self.visited_urls and absolute_url not in self.pending_urls:
                links.append(absolute_url)
        
        return links
    
    def parse_page(self, url: str, html_content: str) -> Dict:
        """解析页面内容"""
        soup = BeautifulSoup(html_content, 'html.parser')
        
        title_tag = soup.find('title')
        title = title_tag.text.strip() if title_tag else '无标题'
        
        paragraphs = []
        for p_tag in soup.find_all('p'):
            text = p_tag.text.strip()
            if text and len(text) > 10:
                paragraphs.append(text)
        
        headings = {}
        for level in range(1, 7):
            tag_name = f'h{level}'
            tags = soup.find_all(tag_name)
            if tags:
                headings[tag_name] = [tag.text.strip() for tag in tags if tag.text.strip()]
        
        meta_desc = None
        meta_tag = soup.find('meta', attrs={'name': 'description'})
        if meta_tag:
            meta_desc = meta_tag.get('content', '').strip()
        
        all_links = self.extract_links(soup, url)
        
        return {
            'url': url,
            'title': title,
            'meta_description': meta_desc,
            'headings': headings,
            'paragraphs': paragraphs,
            'links': all_links,
            'scraped_at': datetime.now().isoformat()
        }
    
    def save_page_data(self, page_data: Dict):
        """保存页面数据"""
        url_hash = hashlib.md5(page_data['url'].encode()).hexdigest()[:16]
        filename = f"{url_hash}.json"
        filepath = os.path.join(self.output_dir, 'pages', filename)
        
        with open(filepath, 'w', encoding='utf-8') as f:
            json.dump(page_data, f, ensure_ascii=False, indent=2)
        
        logger.info(f"💾 已保存: {filepath}")
    
    def crawl(self) -> List[Dict]:
        """开始爬取"""
        logger.info(f"🚀 开始爬取: {self.base_url}")
        
        page_count = 0
        
        while self.pending_urls and page_count < self.max_pages:
            url = self.pending_urls.pop(0)
            
            if url in self.visited_urls:
                continue
            
            if not self.is_allowed(url):
                self.visited_urls.add(url)
                continue
            
            response = self.fetch_page(url)
            if not response:
                self.visited_urls.add(url)
                continue
            
            page_data = self.parse_page(url, response.text)
            self.save_page_data(page_data)
            self.results.append(page_data)
            self.visited_urls.add(url)
            page_count += 1
            
            logger.info(f"📊 进度: {page_count}/{self.max_pages}")
            
            # 将新链接加入队列
            for link in page_data['links']:
                if link not in self.visited_urls and link not in self.pending_urls:
                    self.pending_urls.append(link)
            
            logger.info(f"   ⏳ 待爬取队列: {len(self.pending_urls)} 个URL")
            
            time.sleep(random.uniform(1, 2))
        
        logger.info(f"🎉 爬取完成！共爬取 {len(self.results)} 个页面")
        return self.results

# ==================== 控制版爬虫类 ====================
class ControlledScraper(MultiPageScraper):
    """精确控制爬取范围"""
    
    def __init__(self, 
                 base_url: str,
                 allowed_paths: List[str] = None,
                 max_depth: int = 2,
                 *args, **kwargs):
        super().__init__(base_url, *args, **kwargs)
        self.allowed_paths = allowed_paths or []
        self.max_depth = max_depth
        self.url_depth = {base_url: 0}
        
        logger.info(f"🔒 路径限制: {self.allowed_paths if self.allowed_paths else '无限制'}")
        logger.info(f"🔒 最大深度: {self.max_depth}")
    
    def is_allowed(self, url: str) -> bool:
        """路径限制 + robots.txt"""
        # 检查robots.txt
        if not super().is_allowed(url):
            return False
        
        # 如果指定了路径限制
        if self.allowed_paths:
            parsed = urlparse(url)
            path = parsed.path or '/'
            for allowed_path in self.allowed_paths:
                if path.startswith(allowed_path):
                    return True
            logger.debug(f"⛔ 跳过不在允许路径的URL: {url}")
            return False
        
        return True
    
    def extract_links(self, soup: BeautifulSoup, base_url: str) -> List[str]:
        """提取链接并记录深度"""
        links = super().extract_links(soup, base_url)
        
        # 过滤超出深度的链接
        current_depth = self.url_depth.get(base_url, 0)
        filtered_links = []
        
        for link in links:
            # 检查是否已在队列中
            if link in self.visited_urls or link in self.pending_urls:
                continue
            
            # 记录深度
            self.url_depth[link] = current_depth + 1
            
            # 检查深度限制
            if current_depth + 1 <= self.max_depth:
                filtered_links.append(link)
            else:
                logger.debug(f"⏭️ 跳过深度 {current_depth + 1} 的链接: {link}")
        
        logger.info(f"   🔗 发现 {len(filtered_links)} 个可爬取链接（深度≤{self.max_depth}）")
        return filtered_links

# ==================== 主函数 ====================
def main():
    """主函数"""
    
    # 配置爬虫 - 在这里修改你的设置
    scraper = ControlledScraper(
        base_url='https://xenoblade3.cn/%E6%88%98%E6%96%97%E7%B3%BB%E7%BB%9F',  # 替换为你的网站
        allowed_paths=['/%E6%88%98%E6%96%97%E7%B3%BB%E7%BB%9F'],  # 只爬取这些路径
        max_depth=1,  # 深度限制
        max_pages=20,  # 最大页面数
        output_dir='rag_knowledge_base'
    )
    
    # 开始爬取
    results = scraper.crawl()
    
    # 打印统计
    print("\n" + "="*60)
    print("📊 爬取完成统计")
    print("="*60)
    print(f"总页面数: {len(results)}")
    print(f"总段落数: {sum(len(page.get('paragraphs', [])) for page in results)}")
    print(f"\n📁 数据保存在: {scraper.output_dir}")
    print("="*60)
    
    # 显示爬取的页面列表
    print("\n📄 爬取的页面:")
    for i, page in enumerate(results[:10], 1):
        print(f"  {i}. {page['title']}")
        print(f"     URL: {page['url']}")
    if len(results) > 10:
        print(f"  ... 还有 {len(results) - 10} 个页面")


if __name__ == "__main__":
    main()